{
  "name": "VERITAS-AI",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "postCreateCommand": "curl -LsSf https://astral.sh/uv/install.sh | sh && uv sync --all-groups --frozen",
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "VERITAS-AI dashboard",
      "onAutoForward": "silent",
      "visibility": "private"
    }
  }
}
