{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/veritas-ai/1.0/model_manifest.schema.json",
  "title": "VERITAS-AI model manifest version 1.0",
  "type": "object",
  "required": ["schema_version", "model_type", "model_format", "model_sha256", "features", "classes"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "model_type": {"type": "string"},
    "model_format": {"const": "native_xgboost_json"},
    "model_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "features": {"type": "array", "items": {"type": "string"}},
    "classes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
