{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/veritas-ai/1.0/run_summary.schema.json",
  "title": "VERITAS-AI run summary version 1.0",
  "type": "object",
  "required": ["schema_version", "version", "trl_claim", "limitations", "scenario_actions", "ledger_valid", "artifacts"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "version": {"type": "string"},
    "trl_claim": {"type": "string"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "scenario_actions": {"type": "object"},
    "ledger_valid": {"type": "boolean"},
    "artifacts": {"type": "object"}
  },
  "additionalProperties": true
}
